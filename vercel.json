{
  "version": 2,
  "builds": [
    {
      "src": "myProject12/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "myProject12/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "myProject12.settings",
    "PYTHONUNBUFFERED": "1"
  }
}
